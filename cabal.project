index-state:
  -- Bump both the following dates if you need newer packages from Hackage
  , hackage.haskell.org 2025-01-16T03:16:46Z

packages: .

package cardano-crypto
  flags: +golden-tests +golden-tests-exe

tests: true
test-show-details: direct

package inspector
