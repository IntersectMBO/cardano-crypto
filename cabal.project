source-repository-package
  type: git
  -- Forked from https://github.com/primetype/inspector
  location: https://github.com/input-output-hk/inspector
  tag: e13c4fde2f8c1cb908328e6a6e82db6cf16dd037

if impl (ghc >= 9.10)
  allow-newer:
    , gauge:base
